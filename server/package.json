{
  "name": "apps-server",
  "version": "0.1.0",
  "private": true,
  "description": "Update host for auto-updating Mac apps (Sparkle and electron-updater feeds, downloads, uploads)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
